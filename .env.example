# Database & Cache
DATABASE_URL=postgresql://sitestack:sitestack_dev_password@localhost:5432/sitestack
REDIS_URL=redis://localhost:6379/0

# Google Maps Platform (Use Maps Demo Key for zero-cost prototyping or Cloud Console restricted key for production)
