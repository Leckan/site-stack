ADK_MODEL_NAME=gemini-1.5-pro
MCP_SERVER_SSE_URL=http://localhost:8001/sse
ADK_ORCHESTRATOR_URL=http://localhost:8002
NEXT_PUBLIC_ADK_ORCHESTRATOR_URL=http://localhost:8002

# External Data APIs
